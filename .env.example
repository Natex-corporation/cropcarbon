# Rename to .env and fill with your Stripe credentials before running `npm start`
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
# Public URL where the app is accessible (used for Stripe redirects)
APP_URL=http://localhost:3000

# Firebase configuration for syncing projects, updates, and donations
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=000000000000
FIREBASE_APP_ID=1:000000000000:web:abcdef1234567890
FIREBASE_MEASUREMENT_ID=G-ABCDEFG123
